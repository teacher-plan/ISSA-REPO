# === Supabase Configuration ===
# Get these from your Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only - NEVER expose to the client
# Only used for Auth Admin API and wallet provider config
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# === Application Configuration ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === QR Code Configuration (Optional) ===
# For QR code generation and Wallet integration
NEXT_PUBLIC_QR_CODE_SIZE=512
NEXT_PUBLIC_QR_ERROR_CORRECTION=H

# === Wallet Integration (Optional) ===
# Apple Wallet passkit configuration
# APPLE_WALLET_TEAM_ID=your-team-id
# APPLE_WALLET_KEY_ID=your-key-id
# APPLE_WALLET_CERTIFICATE=your-certificate-path

# Google Wallet configuration
# GOOGLE_WALLET_SERVICE_ACCOUNT=your-service-account-json
# GOOGLE_WALLET_ISSUER_ID=your-issuer-id

# === Analytics (Optional) ===
# NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# === Feature Flags ===
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
